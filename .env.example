# Django
DJANGO_SECRET_KEY=dev-only-change-this-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8000

# PostgreSQL (host-side values; Docker Compose overrides these inside containers)
DB_NAME=places_db
DB_USER=postgres
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=5433

# Redis (host-side values; Docker Compose overrides these inside containers)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# Development email is printed to the Django console by default.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@places.local
